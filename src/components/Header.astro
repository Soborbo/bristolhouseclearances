---
import { site } from '../config/site';
import { mainNav } from '../config/navigation';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200 transition-shadow duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 shrink-0">
        <span class="w-9 h-9 bg-brand-green rounded-lg flex items-center justify-center text-white font-bold text-sm">BH</span>
        <span class="hidden sm:block font-bold text-lg text-brand-navy">Clearfields</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Main navigation">
        {mainNav.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 text-sm font-medium rounded-md transition-colors',
                currentPath.startsWith(item.href) && item.href !== '/'
                  ? 'text-brand-green'
                  : 'text-slate-700 hover:text-brand-green hover:bg-slate-50',
              ]}
            >
              {item.label}
              {item.children && (
                <svg class="inline w-3.5 h-3.5 ml-0.5 -mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-white rounded-lg shadow-lg border border-slate-200 py-2 min-w-[220px]">
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2 text-sm transition-colors',
                        currentPath === child.href
                          ? 'text-brand-green bg-green-50'
                          : 'text-slate-600 hover:text-brand-green hover:bg-slate-50',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Right side: phone + CTA + hamburger -->
      <div class="flex items-center gap-3 sm:gap-4">
        <a
          href={site.phoneHref}
          class="hidden md:flex items-center gap-2 text-brand-navy font-semibold hover:text-brand-green transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          {site.phone}
        </a>

        <a
          href="/contact/"
          class="hidden sm:inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green-dark text-white font-semibold px-4 py-2.5 rounded-lg transition-colors text-sm"
        >
          Get Free Quote
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 -mr-2 text-slate-600 hover:text-brand-green"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4 space-y-1" aria-label="Mobile navigation">
      {mainNav.map(item => (
        <div>
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2.5 text-base font-medium rounded-md transition-colors',
              currentPath.startsWith(item.href) && item.href !== '/'
                ? 'text-brand-green bg-green-50'
                : 'text-slate-700 hover:text-brand-green hover:bg-slate-50',
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="ml-4 mt-1 space-y-0.5">
              {item.children.map(child => (
                <a
                  href={child.href}
                  class:list={[
                    'block px-3 py-2 text-sm rounded-md transition-colors',
                    currentPath === child.href
                      ? 'text-brand-green bg-green-50'
                      : 'text-slate-500 hover:text-brand-green hover:bg-slate-50',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-3 border-t border-slate-100">
        <a
          href={site.phoneHref}
          class="flex items-center gap-2 px-3 py-2.5 text-base font-semibold text-brand-navy"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          {site.phone}
        </a>
        <a
          href="/contact/"
          class="block mx-3 mt-2 text-center bg-brand-green hover:bg-brand-green-dark text-white font-semibold px-4 py-3 rounded-lg transition-colors"
        >
          Get Free Quote
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  }

  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('shadow-md', window.scrollY > 50);
    }, { passive: true });
  }
</script>
