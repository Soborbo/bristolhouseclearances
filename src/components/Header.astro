---
import { site } from '../config/site';
import { mainNav } from '../config/navigation';

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-paper/90 backdrop-blur-md border-b border-line transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Bristol House Clearances home">
        <span class="relative w-10 h-10 bg-cobalt rounded-xl flex items-center justify-center text-white font-extrabold text-sm shadow-[0_8px_18px_-8px_rgba(46,80,224,0.9)]">
          BH
          <span class="absolute -top-1 -right-1 w-3 h-3 bg-sun rounded-full border-2 border-paper"></span>
        </span>
        <span class="flex flex-col leading-none">
          <span class="font-extrabold text-[1.05rem] text-ink tracking-tight">Bristol House</span>
          <span class="text-[0.68rem] font-bold tracking-[0.2em] uppercase text-cobalt mt-0.5">Clearances</span>
        </span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Main navigation">
        {mainNav.map(item => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 px-3 py-2 text-[0.92rem] font-semibold rounded-full transition-colors',
                currentPath.startsWith(item.href) && item.href !== '/'
                  ? 'text-cobalt'
                  : 'text-slate-700 hover:text-cobalt',
              ]}
            >
              {item.label}
              {item.children && (
                <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
              )}
            </a>
            {item.children && (
              <div class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 z-50">
                <div class="bg-white rounded-2xl shadow-[0_24px_60px_-30px_rgba(16,23,42,0.5)] border border-line p-2 min-w-[240px]">
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm font-medium rounded-xl transition-colors',
                        currentPath === child.href
                          ? 'text-cobalt bg-sky'
                          : 'text-slate-600 hover:text-cobalt hover:bg-sky/60',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3 sm:gap-4">
        <a
          href={site.phoneHref}
          class="hidden md:flex items-center gap-2 text-ink font-bold hover:text-cobalt transition-colors"
        >
          <span class="w-9 h-9 rounded-full bg-sky flex items-center justify-center text-cobalt">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
          </span>
          {site.phone}
        </a>

        <a
          href="/contact/"
          class="hidden sm:inline-flex items-center gap-2 bg-cobalt hover:bg-cobalt-dark text-white font-bold px-5 py-2.5 rounded-full transition-all duration-300 text-sm shadow-[0_12px_26px_-14px_rgba(46,80,224,0.9)] hover:-translate-y-0.5"
        >
          Get a free quote
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 -mr-2 text-ink hover:text-cobalt"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-line bg-paper max-h-[80vh] overflow-y-auto">
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-4 space-y-1" aria-label="Mobile navigation">
      {mainNav.map(item => (
        <div>
          <a
            href={item.href}
            class:list={[
              'block px-3 py-2.5 text-base font-semibold rounded-xl transition-colors',
              currentPath.startsWith(item.href) && item.href !== '/'
                ? 'text-cobalt bg-sky'
                : 'text-slate-700 hover:text-cobalt hover:bg-sky/60',
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="ml-3 mt-1 mb-1 space-y-0.5 border-l-2 border-line pl-3">
              {item.children.map(child => (
                <a
                  href={child.href}
                  class:list={[
                    'block px-3 py-2 text-sm rounded-lg transition-colors',
                    currentPath === child.href ? 'text-cobalt' : 'text-slate-500 hover:text-cobalt',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-3 mt-2 border-t border-line">
        <a href={site.phoneHref} class="flex items-center gap-2 px-3 py-2.5 text-base font-bold text-ink">
          <svg class="w-5 h-5 text-cobalt" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
          {site.phone}
        </a>
        <a href="/contact/" class="block mx-3 mt-2 text-center bg-cobalt hover:bg-cobalt-dark text-white font-bold px-4 py-3 rounded-full transition-colors">
          Get a free quote
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
    });
  }
  const header = document.getElementById('site-header');
  if (header) {
    window.addEventListener('scroll', () => {
      header.classList.toggle('shadow-[0_10px_30px_-20px_rgba(16,23,42,0.45)]', window.scrollY > 40);
    }, { passive: true });
  }
</script>
