---
import { site } from '../../config/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Get Your Free Quote Today',
  text = "Send us photos via WhatsApp or call us for an instant, no-obligation quote. Price Lock Guarantee — your quote won't go up.",
} = Astro.props;
---

<section class="bg-brand-green py-12 sm:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">{heading}</h2>
    <p class="text-green-100 text-lg mb-8 max-w-2xl mx-auto">{text}</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="/contact/"
        class="inline-flex items-center gap-2 bg-white text-brand-green font-bold px-8 py-3.5 rounded-lg hover:bg-green-50 transition-colors text-lg"
      >
        Get Free Quote
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
      </a>
      <a
        href={site.phoneHref}
        class="inline-flex items-center gap-2 bg-transparent border-2 border-white text-white font-semibold px-8 py-3.5 rounded-lg hover:bg-white/10 transition-colors text-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>
        Call {site.phone}
      </a>
    </div>
  </div>
</section>
