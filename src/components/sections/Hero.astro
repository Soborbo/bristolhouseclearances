---
import { Picture } from 'astro:assets';
import { site } from '../../config/site';
import heroImage from '../../assets/img/clearfields-house-clearance-bristol-09.jpg';
import Button from '../ui/Button.astro';

const whatsappHref = `${site.whatsappUrl}?text=Hi%2C%20I%27d%20like%20a%20clearance%20quote.%20Here%20are%20photos%3A`;

const trust = ['Easy to deal with', '£2M insured', '4.9★ on Google'];
---

<section id="hero" class="relative overflow-hidden">
  <div class="pointer-events-none absolute -top-32 -right-40 w-[42rem] h-[42rem] rounded-full bg-cobalt/5 blur-3xl"></div>
  <div class="pointer-events-none absolute top-1/2 -left-40 w-[34rem] h-[34rem] rounded-full bg-sun/10 blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-10 items-center">
      <!-- LEFT -->
      <div data-reveal>
        <span class="inline-flex items-center gap-2 bg-sky text-cobalt font-bold text-[0.82rem] px-4 py-2 rounded-full">
          <span class="w-2 h-2 rounded-full bg-sun"></span> Bristol &amp; the South West
        </span>

        <h1 class="mt-6 text-[2.8rem] leading-[1.0] sm:text-6xl lg:text-[4.4rem] font-extrabold tracking-tight text-ink">
          Clear the clutter,
          <span class="relative inline-block">
            <span class="relative z-10">keep the calm.</span>
            <span class="absolute inset-x-[-4px] bottom-1 h-[42%] bg-sun -rotate-1 rounded-md z-0"></span>
          </span>
        </h1>

        <p class="mt-6 text-lg text-slate-600 leading-relaxed max-w-xl">
          Friendly, fully-insured house, probate and office clearance.
          <strong class="text-ink font-bold">Fair fixed prices from £60</strong>, agreed before we start —
          and we credit back anything worth selling. Same-week slots, and 95% kept out of landfill.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <Button href="#contact" variant="primary" size="lg">
            Get a free quote
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.4"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </Button>
          <Button href={whatsappHref} variant="outline" size="lg" target="_blank" rel="noopener">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
            WhatsApp us photos
          </Button>
        </div>

        <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2">
          {trust.map((t) => (
            <li class="flex items-center gap-2 text-sm font-semibold text-slate-600">
              <svg class="w-4 h-4 text-cobalt shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>

      <!-- RIGHT -->
      <div class="relative" data-reveal style="--reveal-delay:120ms">
        <div class="rounded-[1.75rem] overflow-hidden border-4 border-white shadow-[0_30px_70px_-30px_rgba(16,23,42,0.5)]">
          <Picture
            src={heroImage}
            widths={[480, 640, 960, 1200]}
            sizes="(min-width:1024px) 32rem, 90vw"
            formats={['avif', 'webp']}
            quality={64}
            alt="Bristol House Clearances team loading a van"
            loading="eager"
            fetchpriority="high"
            class="w-full h-[26rem] sm:h-[28rem] object-cover"
          />
        </div>
        <div class="absolute -top-4 -right-3 bg-sun text-ink font-extrabold text-sm px-4 py-3.5 rounded-2xl shadow-[0_14px_24px_-10px_rgba(0,0,0,0.25)] text-center leading-tight animate-wob">
          we load it,<br>not you!
        </div>
        <div class="absolute -left-4 bottom-6 bg-white rounded-2xl px-5 py-4 shadow-[0_22px_44px_-18px_rgba(16,23,42,0.4)]">
          <p class="eyebrow text-cobalt text-[0.62rem]">Fixed prices</p>
          <p class="text-3xl font-extrabold text-ink leading-none mt-1">from £60</p>
          <p class="text-xs text-slate-500 font-semibold mt-1">Free, no-obligation quote</p>
        </div>
      </div>
    </div>
  </div>
</section>
