---
interface ServiceLink {
  title: string;
  href: string;
  description: string;
}

interface Props {
  heading?: string;
  services: ServiceLink[];
}

const { heading = 'Related Services', services } = Astro.props;
---

<aside class="bg-slate-50 rounded-xl p-6">
  <h3 class="text-lg font-bold text-brand-navy mb-4">{heading}</h3>
  <ul class="space-y-3">
    {services.map(service => (
      <li>
        <a href={service.href} class="group block">
          <span class="text-brand-green font-medium group-hover:underline">{service.title}</span>
          <p class="text-sm text-slate-500 mt-0.5">{service.description}</p>
        </a>
      </li>
    ))}
  </ul>
</aside>
