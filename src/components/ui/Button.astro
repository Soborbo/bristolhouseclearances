---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'whatsapp' | 'outline' | 'sun';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';

const baseClasses = 'inline-flex items-center justify-center gap-2 font-bold rounded-full transition-all duration-300 ease-out focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-cobalt whitespace-nowrap active:translate-y-px';

const variantClasses = {
  primary: 'bg-cobalt hover:bg-cobalt-dark text-white shadow-[0_12px_28px_-14px_rgba(46,80,224,0.8)] hover:-translate-y-0.5',
  secondary: 'bg-ink hover:bg-brand-navy-dark text-white hover:-translate-y-0.5',
  whatsapp: 'bg-[#25D366] hover:bg-[#20bd5a] text-white hover:-translate-y-0.5',
  outline: 'border-2 border-ink text-ink hover:bg-sun hover:border-sun',
  sun: 'bg-sun hover:bg-sun-dark text-ink hover:-translate-y-0.5',
};

const sizeClasses = {
  sm: 'px-5 py-2.5 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};
---

<Tag
  href={href}
  class:list={[baseClasses, variantClasses[variant], sizeClasses[size], className]}
  {...rest}
>
  <slot />
</Tag>
