---
interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  id?: string;
  class?: string;
  light?: boolean;
  align?: 'center' | 'left';
}
const { title, subtitle, eyebrow, id, class: className = '', light = false, align = 'center' } = Astro.props;
---

<div
  class:list={[align === 'center' ? 'text-center mx-auto max-w-2xl' : 'text-left max-w-2xl', 'mb-10 lg:mb-14', className]}
  id={id}
  data-reveal
>
  {eyebrow && (
    <span class:list={['eyebrow', light ? 'text-sun' : 'text-cobalt']}>{eyebrow}</span>
  )}
  <h2
    class:list={[
      'text-3xl sm:text-4xl lg:text-[2.7rem] font-extrabold leading-[1.06] tracking-tight',
      eyebrow ? 'mt-3' : '',
      light ? 'text-white' : 'text-ink',
    ]}
  >
    {title}
  </h2>
  {subtitle && (
    <p class:list={['mt-4 text-lg leading-relaxed', align === 'center' ? 'mx-auto' : '', light ? 'text-white/70' : 'text-slate-600']}>
      {subtitle}
    </p>
  )}
</div>
