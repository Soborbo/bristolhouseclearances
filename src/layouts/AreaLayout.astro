---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import type { BreadcrumbItem } from '../components/Breadcrumb.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import FloatingMobileBar from '../components/FloatingMobileBar.astro';
import BackToTop from '../components/BackToTop.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import { site } from '../config/site';

interface FAQ {
  q: string;
  a: string;
}

interface NearbyArea {
  name: string;
  slug: string;
}

interface Props {
  title: string;
  description: string;
  h1: string;
  area: string;
  breadcrumbs: BreadcrumbItem[];
  postcodes?: string[];
  propertyTypes?: string[];
  nearestRecyclingCentre?: string;
  localCharities?: string[];
  nearbyAreas?: NearbyArea[];
  faqs?: FAQ[];
}

const { title, description, h1, area, breadcrumbs, postcodes = [], propertyTypes = [], nearestRecyclingCentre, localCharities = [], nearbyAreas = [], faqs = [] } = Astro.props;

const faqSchema = faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
} : null;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `House Clearance in ${area}`,
  provider: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: site.phone,
  },
  areaServed: {
    '@type': 'City',
    name: area,
  },
  serviceType: 'House Clearance',
};
---

<Layout title={title} description={description}>
  <Header />
  <main id="main-content">
    <div class="bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <Breadcrumb items={breadcrumbs} />
      </div>
    </div>

    <section class="bg-brand-navy text-white py-12 sm:py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">{h1}</h1>
          <slot name="hero-subtitle" />
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="lg:col-span-2 prose prose-slate prose-lg max-w-none prose-headings:text-brand-navy prose-a:text-brand-green">
          <slot />

          {faqs.length > 0 && (
            <section class="not-prose mt-12">
              <h2 class="text-2xl font-bold text-brand-navy mb-6">Frequently Asked Questions About {area}</h2>
              <div class="space-y-3">
                {faqs.map(faq => (
                  <details class="group bg-slate-50 rounded-lg">
                    <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-medium text-brand-navy hover:bg-slate-100 rounded-lg transition-colors">
                      {faq.q}
                      <svg class="w-5 h-5 shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                    </summary>
                    <div class="px-5 pb-4 text-slate-600 leading-relaxed">{faq.a}</div>
                  </details>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="lg:col-span-1 space-y-8">
          <div class="bg-brand-green rounded-xl p-6 text-white text-center">
            <h3 class="text-xl font-bold mb-2">Free Quote for {area}</h3>
            <p class="text-green-100 text-sm mb-4">Local team, same-day response</p>
            <a href="/contact/" class="block bg-white text-brand-green font-bold py-3 rounded-lg hover:bg-green-50 transition-colors">
              Request Quote
            </a>
          </div>

          {postcodes.length > 0 && (
            <div class="bg-slate-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-brand-navy mb-3">Postcodes Covered</h3>
              <div class="flex flex-wrap gap-2">
                {postcodes.map(pc => (
                  <span class="bg-white px-3 py-1 rounded-full text-sm text-slate-600 border border-slate-200">{pc}</span>
                ))}
              </div>
            </div>
          )}

          {propertyTypes.length > 0 && (
            <div class="bg-slate-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-brand-navy mb-3">Property Types</h3>
              <ul class="space-y-2">
                {propertyTypes.map(type => (
                  <li class="flex items-center gap-2 text-sm text-slate-600">
                    <svg class="w-4 h-4 text-brand-green shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                    {type}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {nearestRecyclingCentre && (
            <div class="bg-slate-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-brand-navy mb-3">Nearest Recycling Centre</h3>
              <p class="text-sm text-slate-600">{nearestRecyclingCentre}</p>
            </div>
          )}

          {localCharities.length > 0 && (
            <div class="bg-slate-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-brand-navy mb-3">Charity Partners</h3>
              <ul class="space-y-2">
                {localCharities.map(charity => (
                  <li class="text-sm text-slate-600">{charity}</li>
                ))}
              </ul>
            </div>
          )}

          {nearbyAreas.length > 0 && (
            <div class="bg-slate-50 rounded-xl p-6">
              <h3 class="text-lg font-bold text-brand-navy mb-3">Nearby Areas</h3>
              <ul class="space-y-2">
                {nearbyAreas.map(a => (
                  <li>
                    <a href={`/areas/${a.slug}/`} class="text-sm text-brand-green hover:underline">{a.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="bg-slate-50 rounded-xl p-6">
            <h3 class="text-lg font-bold text-brand-navy mb-3">Our Services in {area}</h3>
            <ul class="space-y-2">
              <li><a href="/house-clearance/" class="text-sm text-brand-green hover:underline">House Clearance in {area}</a></li>
              <li><a href="/probate-house-clearance/" class="text-sm text-brand-green hover:underline">Probate Clearance in {area}</a></li>
              <li><a href="/commercial-clearance/" class="text-sm text-brand-green hover:underline">Commercial Clearance in {area}</a></li>
              <li><a href="/garden-clearance/" class="text-sm text-brand-green hover:underline">Garden Clearance in {area}</a></li>
            </ul>
          </div>

          <slot name="sidebar" />
        </aside>
      </div>
    </div>

    <CTABanner heading={`Need a Clearance in ${area}?`} text="Get a free, no-obligation quote from our local Bristol team today." />
  </main>
  <Footer />
  <FloatingMobileBar />
  <BackToTop />
  <SchemaLocalBusiness />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>
