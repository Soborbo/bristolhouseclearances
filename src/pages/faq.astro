---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import FloatingMobileBar from '../components/FloatingMobileBar.astro';
import BackToTop from '../components/BackToTop.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'FAQ' },
];

const categories = [
  {
    name: 'Pricing & Costs',
    faqs: [
      { q: 'How much does a house clearance cost in Bristol?', a: 'A typical house clearance in Bristol costs between £175 and £900 depending on property size, volume and access. A 1-bed flat starts from around £175, a 2-3 bed house typically costs £300–£500, and larger properties from £500 upwards. We provide free, no-obligation quotes. See our <a href="/guides/house-clearance-cost-bristol/">full cost guide</a>.' },
      { q: 'What is the Price Lock Guarantee?', a: 'Once we quote a price, that price is locked. It will not increase on the day of clearance, even if there\'s more to clear than expected. This protects you from the "surprise fees" many customers have experienced with other companies.' },
      { q: 'Do you charge for a quote?', a: 'No. All quotes are completely free and come with no obligation. You can get a quote by sending us WhatsApp photos, calling us, or filling in our <a href="/contact/">online form</a>. We aim to respond within 2 hours.' },
      { q: 'Are there any hidden costs?', a: 'No. Our quote includes loading, transport, disposal, Waste Transfer Notes and a besom clean. The only exception is if you ask us to clear additional items on the day that weren\'t in the original scope — and we\'ll always agree a price before doing any additional work.' },
      { q: 'How does your pricing compare to skip hire?', a: 'House clearance is typically similar in cost to skip hire but includes all the labour. A skip costs £200-350 for the hire alone — you still have to load it yourself. We handle everything. Read our <a href="/guides/house-clearance-vs-skip-hire/">detailed comparison</a>.' },
    ],
  },
  {
    name: 'The Clearance Process',
    faqs: [
      { q: 'How does the process work?', a: 'It\'s simple: (1) Send us photos or call for a free quote, (2) We respond within 2 hours with a locked price, (3) Our team arrives on your chosen date, clears everything, and leaves the property clean. We send live photo updates throughout.' },
      { q: 'How long does a clearance take?', a: 'Most 2-3 bedroom houses are cleared within a single day (4-6 hours). Smaller properties take 2-4 hours. Larger or heavily furnished properties may require a full day or two. We always confirm the timeline upfront.' },
      { q: 'Do I need to be present?', a: 'No. Many clients arrange key handover, lockbox access or neighbour collection. We send WhatsApp photo updates throughout the day so you can monitor progress remotely.' },
      { q: 'Can you work around items I want to keep?', a: 'Absolutely. Just tell us what to leave and we work around it. Many clients walk through the property first to collect personal items, then we handle the rest.' },
      { q: 'What do you do with the items you clear?', a: 'We sort everything on site. Usable items go to local charities (SOFA Project, Emmaus Bristol, BHF). Recyclable materials go to licensed recycling facilities. Only genuinely non-recyclable waste goes to controlled landfill — less than 5% of what we clear.' },
    ],
  },
  {
    name: 'Environmental & Legal',
    faqs: [
      { q: 'Are you a licensed waste carrier?', a: 'Yes. We are registered as an Upper Tier Waste Carrier with the Environment Agency. Our registration details are available on request and can be verified via the Environment Agency public register.' },
      { q: 'What is your recycling rate?', a: 'We recycle or donate at least 95% of everything we clear. This includes furniture, electrical items, metals, textiles, paper and general recyclables. We provide a Charity Donation Report after every clearance.' },
      { q: 'Do you provide Waste Transfer Notes?', a: 'Yes. Waste Transfer Notes are provided for every job as required by law. These documents confirm your waste was disposed of legally and responsibly. We retain copies for 2 years.' },
      { q: 'How do you handle hazardous waste?', a: 'We handle common hazardous items including paints, chemicals, batteries, fluorescent tubes and asbestos-containing materials. These are disposed of through licensed hazardous waste facilities in accordance with regulations.' },
    ],
  },
  {
    name: 'Specialist Services',
    faqs: [
      { q: 'Do you handle probate clearances?', a: 'Yes. Our <a href="/probate-house-clearance/">probate clearance service</a> is specifically designed for executors and families. We provide careful item sorting, valuations flagging, inventory lists and work sensitively with bereaved families.' },
      { q: 'Can you clear a hoarder\'s property?', a: 'Yes. Our <a href="/house-clearance/hoarder-clearance/">hoarder clearance service</a> uses a staged, sensitive approach. We never rush the process, work at the client\'s pace, and can coordinate with support services if needed.' },
      { q: 'Do you offer commercial clearance?', a: 'Yes. We clear offices, shops, warehouses and industrial premises. We are WEEE compliant, provide Duty of Care documentation, and can work outside business hours. See our <a href="/commercial-clearance/">commercial clearance</a> page.' },
      { q: 'Do you clear gardens and garages?', a: 'Yes. Our <a href="/garden-clearance/">garden clearance</a> service covers all garden waste, sheds, garages, outbuildings and garden furniture. We also handle soil, rubble and hazardous garden chemicals.' },
    ],
  },
  {
    name: 'Booking & Availability',
    faqs: [
      { q: 'How quickly can you come?', a: 'We offer same-day clearance subject to availability. For planned clearances, we typically schedule within 2-5 working days. Urgent probate or end-of-tenancy clearances can often be fast-tracked.' },
      { q: 'What areas do you cover?', a: 'We cover all of Bristol, Bath and surrounding areas within a 30-mile radius. This includes South Gloucestershire, North Somerset and B&NES. View all <a href="/areas/">areas we cover</a>.' },
      { q: 'Do you work weekends?', a: 'Yes. We work Monday to Saturday 7am-7pm as standard. Sunday and bank holiday clearances are available by appointment.' },
      { q: 'What payment methods do you accept?', a: 'We accept bank transfer, debit/credit card and cash. Payment is due on completion of the clearance.' },
      { q: 'What if I need to cancel or reschedule?', a: 'We understand plans change. We ask for 24 hours\' notice for cancellations or rescheduling. There is no cancellation fee.' },
    ],
  },
];

const allFaqs = categories.flatMap(c => c.faqs);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout
  title="FAQ | House Clearance Questions Answered — Bristol House Clearances"
  description="Answers to common house clearance questions. Pricing, process, recycling, legal requirements and more. Bristol House Clearances FAQ."
>
  <Header />
  <main id="main-content">
    <div class="bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <Breadcrumb items={breadcrumbs} />
      </div>
    </div>

    <section class="bg-brand-navy text-white py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
        <p class="text-xl text-slate-300 max-w-2xl">Everything you need to know about house clearance in Bristol. Can't find your answer? <a href="/contact/" class="text-white underline">Get in touch</a>.</p>
      </div>
    </section>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      {categories.map(category => (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-brand-navy mb-6">{category.name}</h2>
          <div class="space-y-3">
            {category.faqs.map(faq => (
              <details class="group bg-slate-50 rounded-lg">
                <summary class="flex items-center justify-between cursor-pointer px-5 py-4 font-medium text-brand-navy hover:bg-slate-100 rounded-lg transition-colors">
                  {faq.q}
                  <svg class="w-5 h-5 shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
                </summary>
                <div class="px-5 pb-4 text-slate-600 leading-relaxed" set:html={faq.a} />
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <CTABanner />
  </main>
  <Footer />
  <FloatingMobileBar />
  <BackToTop />
  <SchemaLocalBusiness />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
