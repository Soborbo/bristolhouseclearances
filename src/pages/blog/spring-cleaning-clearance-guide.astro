  readingTime="3 min"
  relatedGuides={[
    { title: 'House Clearance Cost Bristol', href: '/guides/house-clearance-cost-bristol/' },
    { title: 'Donate Furniture in Bristol', href: '/guides/donate-furniture-bristol/' },
