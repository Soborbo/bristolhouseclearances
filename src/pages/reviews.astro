---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTABanner from '../components/sections/CTABanner.astro';
import FloatingMobileBar from '../components/FloatingMobileBar.astro';
import BackToTop from '../components/BackToTop.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Reviews' },
];

const reviews = [
  { name: 'Sarah T.', area: 'Clifton', service: 'Probate Clearance', rating: 5, text: 'Absolutely brilliant service during an incredibly difficult time. The team were respectful, careful with our late mother\'s belongings, and went above and beyond. They flagged several items of value we would have missed. Can\'t recommend highly enough.', date: '2025-11' },
  { name: 'Mark D.', area: 'Fishponds', service: 'House Clearance', rating: 5, text: 'Price Lock Guarantee is the real deal. Quoted £380, paid £380. No nasty surprises. The lads were punctual, worked efficiently, and left the place spotless. Will use again for the rental property.', date: '2025-10' },
  { name: 'Linda & John W.', area: 'Henleaze', service: 'Downsizing Clearance', rating: 5, text: 'We were downsizing from our 4-bed to a bungalow and dreading the clearance. The team were patient, let us take our time deciding what to keep, and even helped arrange charity donations. Lovely people.', date: '2025-10' },
  { name: 'James R.', area: 'Bedminster', service: 'End of Tenancy', rating: 5, text: 'Use these guys for all my rental turnarounds. Fast, reliable, good price. They\'ve never let me down in 18 months of regular use. The landlord priority account is brilliant.', date: '2025-09' },
  { name: 'Angela P.', area: 'Keynsham', service: 'Garden Clearance', rating: 5, text: 'Garden was completely overgrown after 2 years of neglect. The team transformed it in a day — cleared everything including an old shed. Looked like a different garden. Excellent value.', date: '2025-09' },
  { name: 'Robert H.', area: 'Southville', service: 'House Clearance', rating: 5, text: 'Third time using Bristol House Clearances. Consistently excellent. This time it was a full 3-bed clearance and they had it done by lunchtime. Love the charity donation report — great to know where things ended up.', date: '2025-08' },
  { name: 'Karen M.', area: 'Totterdown', service: 'Furniture Removal', rating: 5, text: 'Needed a sofa and two wardrobes removed at short notice. They came the same day and were done in 20 minutes. Very reasonable price too. Simple, efficient, friendly.', date: '2025-08' },
  { name: 'David S.', area: 'Bradley Stoke', service: 'Commercial Clearance', rating: 5, text: 'Cleared our office of 15 years\' worth of furniture and IT equipment. They handled the WEEE disposal properly and gave us certificates for the hard drives. Very professional outfit.', date: '2025-07' },
  { name: 'Patricia N.', area: 'Redland', service: 'Hoarder Clearance', rating: 5, text: 'My father\'s house was in a terrible state. The team were incredibly sensitive and patient. They worked over three visits and never once made us feel judged. Truly compassionate service.', date: '2025-07' },
  { name: 'Tom B.', area: 'Bishopston', service: 'Loft Clearance', rating: 5, text: 'Cleared 30 years of stuff from our loft ready for conversion. Quick, tidy, and they recycled everything they could. Great price and lovely team.', date: '2025-06' },
];

const aggregateSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Bristol House Clearances',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.9',
    bestRating: '5',
    ratingCount: '200',
    reviewCount: '200',
  },
  review: reviews.slice(0, 5).map(r => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    datePublished: r.date,
    reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
    reviewBody: r.text,
  })),
};
---

<Layout
  title="Reviews | 4.9★ from 200+ Customers — Bristol House Clearances"
  description="Read genuine reviews from 200+ Bristol customers. 4.9-star average rating. House clearance, probate, commercial and garden clearance reviews."
>
  <Header />
  <main id="main-content">
    <div class="bg-slate-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <Breadcrumb items={breadcrumbs} />
      </div>
    </div>

    <section class="bg-brand-navy text-white py-12 sm:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Customer Reviews</h1>
        <p class="text-xl text-slate-300 max-w-2xl">Don't take our word for it — here's what our Bristol customers say about us.</p>
        <div class="mt-6 flex items-center gap-4">
          <div class="flex text-yellow-400">
            {Array.from({length: 5}).map(() => (
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          <span class="text-2xl font-bold">4.9/5</span>
          <span class="text-slate-300">from 200+ Google reviews</span>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {reviews.map(review => (
          <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-md transition-shadow">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-10 h-10 bg-brand-green/10 rounded-full flex items-center justify-center">
                <span class="text-brand-green font-bold text-sm">{review.name.charAt(0)}</span>
              </div>
              <div>
                <p class="font-semibold text-brand-navy">{review.name}</p>
                <p class="text-xs text-slate-500">{review.service} — {review.area}</p>
              </div>
              <div class="ml-auto flex text-yellow-400">
                {Array.from({length: review.rating}).map(() => (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                ))}
              </div>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">{review.text}</p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <p class="text-slate-600 mb-4">Want to leave a review? We'd love to hear from you.</p>
        <a href="https://g.page/bristolhouseclearances" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-brand-green hover:bg-brand-green-dark text-white font-semibold px-6 py-3 rounded-lg transition-colors">
          Leave a Google Review
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
        </a>
      </div>
    </div>

    <CTABanner />
  </main>
  <Footer />
  <FloatingMobileBar />
  <BackToTop />
  <SchemaLocalBusiness />
  <script type="application/ld+json" set:html={JSON.stringify(aggregateSchema)} />
</Layout>
