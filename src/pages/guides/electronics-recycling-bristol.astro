      <tr><td>Laptops and PCs</td><td>Recycling centre or donation</td><td>Wipe data first</td></tr>
      <tr><td>Phones and tablets</td><td>Retailer take-back or donation</td><td>Factory reset before disposal</td></tr>
      <tr><td>Printers</td><td>Recycling centre</td><td>Remove ink cartridges separately</td></tr>
